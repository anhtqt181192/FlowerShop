<StatusMessage Message="@StatusMessage" />
<h3>Mã khôi phục</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <strong>Đặt các mã này vào nơi an toàn.</strong>
    </p>
    <p>
        Nếu bạn mất thiết bị và không có mã khôi phục, bạn sẽ mất quyền truy cập vào tài khoản của mình.
    </p>
</div>
<div class="row">
    <div class="col-md-12">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <div>
                <code class="recovery-code">@recoveryCode</code>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
